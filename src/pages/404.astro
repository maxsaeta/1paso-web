---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada - NeuroPaso" noindex>
  <main class="container" style="text-align: center; padding: 4rem 1rem;">
    <h1 style="font-size: 6rem; margin: 0; color: var(--primary);">404</h1>
    <h2 style="margin-top: 1rem; font-size: 1.5rem;">Página no encontrada</h2>
    <p style="margin: 1.5rem 0; color: var(--on-surface-variant); max-width: 400px; margin-left: auto; margin-right: auto;">
      Lo sentimos, la página que buscas no existe o ha sido movida.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem;">
      <a href="/landing/" class="btn-primary">Ir al inicio</a>
      <a href="/app" class="btn-secondary">Conocer la app</a>
    </div>
  </main>
</Layout>