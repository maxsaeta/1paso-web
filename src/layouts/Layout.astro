---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'NeuroPaso: productividad con compasión para mentes neurodivergentes' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/assets/favicon.png" type="image/png">
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --primary: #e84057;
    --on-primary: #ffffff;
    --primary-container: #5c1940;
    --on-primary-container: #ffd8e4;
    --secondary: #d0b8c9;
    --secondary-container: #523f4f;
    --tertiary: #c4c8ff;
    --tertiary-container: #413d78;
    --background: #1a1120;
    --on-background: #ece0e7;
    --surface: #1a1120;
    --surface-container: #271e28;
    --surface-container-high: #322832;
    --on-surface: #ece0e7;
    --on-surface-variant: #d0c2cc;
    --outline: #9a8d97;
    --outline-variant: #4e444c;
    --success: #4ade80;
    --warning: #fbbf24;
    --info: #3b82f6;
    --error: #f87171;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: var(--background);
    color: var(--on-background);
    line-height: 1.6;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(26, 17, 32, 0.95);
    backdrop-filter: blur(10px);
    z-index: 1000;
    border-bottom: 1px solid var(--outline-variant);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    font-size: 24px;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-links a {
    color: var(--on-surface-variant);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--primary); }

  .cta-button {
    background: var(--primary);
    color: var(--on-primary);
    padding: 12px 24px;
    border-radius: 20px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(232, 64, 87, 0.3);
  }

  .back-link {
    color: var(--on-surface-variant);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--primary); }

  .btn-primary {
    background: var(--primary);
    color: var(--on-primary);
    padding: 16px 32px;
    border-radius: 24px;
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(232, 64, 87, 0.3);
  }

  .btn-secondary {
    background: var(--surface-container);
    color: var(--on-surface);
    padding: 16px 32px;
    border-radius: 24px;
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
    border: 1px solid var(--outline-variant);
    transition: background 0.2s;
  }

  .btn-secondary:hover { background: var(--surface-container-high); }

  .section-title {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-title h2 {
    font-size: 36px;
    margin-bottom: 16px;
  }

  .section-title p {
    color: var(--on-surface-variant);
    font-size: 18px;
  }

  footer {
    padding: 48px 0;
    border-top: 1px solid var(--outline-variant);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
  }

  .footer-section h4 {
    font-size: 16px;
    margin-bottom: 16px;
    color: var(--primary);
  }

  .footer-section ul { list-style: none; }

  .footer-section li { margin-bottom: 8px; }

  .footer-section a {
    color: var(--on-surface-variant);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  .footer-section a:hover { color: var(--primary); }

  .footer-developer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-top: 24px;
    margin-top: 24px;
    border-top: 1px solid var(--outline-variant);
  }

  .footer-developer p {
    color: var(--on-surface-variant);
    font-size: 14px;
  }

  .footer-developer strong { color: var(--on-surface); }

  .footer-bottom {
    text-align: center;
    padding-top: 32px;
    margin-top: 32px;
    border-top: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
  }
</style>
