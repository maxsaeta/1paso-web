---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** 'website' en la portada y /app, 'article' donde aplique. */
  ogType?: 'website' | 'article';
  /** Solo en paginas que deben quedar fuera del indice. */
  noindex?: boolean;
  /** Preguntas frecuentes para el JSON-LD FAQPage. */
  faq?: { question: string; answer: string }[];
}

const {
  title,
  description = 'NeuroPaso: divide tus tareas en micro-pasos accionables y avanza un paso a la vez.',
  ogImage = '/assets/og-image.png',
  ogType = 'website',
  noindex = false,
  faq = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://neuropaso.netlify.app');
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(ogImage, site);

const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.unpaso.app';
const CONTACT_EMAIL = 'maxsaeta@gmail.com';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'NeuroPaso',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Android 8.0 o superior',
  description,
  url: canonicalURL.toString(),
  installUrl: PLAY_URL,
  downloadUrl: PLAY_URL,
  applicationId: 'com.unpaso.app',
  logo: new URL('/assets/icon.png', site).href,
  image: ogImageURL.href,
  screenshot: new URL('/assets/og-image.png', site).href,
  author: {
    '@type': 'Organization',
    name: 'NeuroPaso',
    url: site.origin,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NeuroPaso',
  url: site.origin,
  logo: new URL('/assets/icon.png', site).href,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: CONTACT_EMAIL,
    availableLanguage: ['es'],
  },
};

const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    }
  : null;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="NeuroPaso">
  {noindex ? (
    <meta name="robots" content="noindex, follow">
  ) : (
    <link rel="canonical" href={canonicalURL}>
  )}

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png">
  <link rel="icon" type="image/png" sizes="128x128" href="/assets/favicon-128.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512.png">
  <link rel="shortcut icon" href="/assets/favicon.ico">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#006E54">
  <meta name="application-name" content="NeuroPaso">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="NeuroPaso">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">

  <!-- Abrir la app instalada desde un Android -->
  <meta name="google-play-app:android:package" content="com.unpaso.app">

  <!-- Open Graph -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageURL.href}>
  <meta property="og:image:alt" content="NeuroPaso: una tarea a la vez, sin abrumarse">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="NeuroPaso">
  <meta property="og:locale" content="es_ES">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageURL.href}>
  <meta name="twitter:image:alt" content="NeuroPaso: una tarea a la vez, sin abrumarse">

  <!-- DNS Prefetch / Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">

  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  /* Color, tipografia, espaciado, radios y breakpoints viven en tokens.css.
     Los valores vienen de Color.kt de la app Android. */
  @import '../styles/tokens.css';

      * { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--font-family);
    background-color: var(--background);
    color: var(--on-background);
    line-height: 1.6;
    font-size: var(--text-body-large);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* Header */
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--surface) 95%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    border-bottom: 1px solid var(--outline-variant);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-4);
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--primary);
  }

  .logo-mark {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .logo-text {
    font-size: var(--text-title-large);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, var(--primary), var(--tertiary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav-links {
    display: flex;
    gap: var(--space-6);
    list-style: none;
  }

  .nav-links a {
    color: var(--on-surface-variant);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-body-medium);
    transition: color 0.2s ease;
    padding: var(--space-1) 0;
    border-bottom: 2px solid transparent;
  }

  .nav-links a:hover,
  .nav-links a:focus {
    color: var(--primary);
    border-bottom-color: var(--primary);
    outline: none;
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--primary);
    color: var(--on-primary);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-body-medium);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    border: none;
    cursor: pointer;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--elevation-3);
  }

  .cta-button:active {
    transform: translateY(0);
  }

  .cta-button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--primary);
    color: var(--on-primary);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-title-small);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    border: none;
    cursor: pointer;
    min-height: 48px;
    min-width: 48px;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--elevation-3);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--surface-container);
    color: var(--on-surface);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-title-small);
    border: 1px solid var(--outline-variant);
    transition: background 0.15s ease, border-color 0.15s ease;
    min-height: 48px;
    min-width: 48px;
  }

  .btn-secondary:hover {
    background: var(--surface-container-high);
    border-color: var(--outline);
  }

  .btn-secondary:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .section-title h2 {
    font-size: var(--text-headline-medium);
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--on-background);
  }

  .section-title p {
    color: var(--on-surface-variant);
    font-size: var(--text-body-large);
    max-width: 600px;
    margin: 0 auto;
  }

  footer {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--outline-variant);
    background: var(--surface-container);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .footer-section h4 {
    font-size: var(--text-title-small);
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--primary);
  }

  .footer-section ul { list-style: none; }

  .footer-section li { margin-bottom: var(--space-2); }

  .footer-section a {
    color: var(--on-surface-variant);
    text-decoration: none;
    font-size: var(--text-body-small);
    transition: color 0.15s ease;
  }

  .footer-section a:hover,
  .footer-section a:focus {
    color: var(--primary);
    outline: none;
  }

  .footer-section a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }

  .footer-divider {
    border-top: 1px solid var(--outline-variant);
    margin: var(--space-8) 0;
  }

  .footer-bottom {
    text-align: center;
    padding-top: var(--space-6);
    color: var(--on-surface-variant);
    font-size: var(--text-body-small);
  }

  .footer-bottom p { margin-bottom: var(--space-1); }

  /* Skip link for accessibility */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    background: var(--primary);
    color: var(--on-primary);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    z-index: 9999;
    text-decoration: none;
    font-weight: 600;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  /* Focus visible polyfill fallback */
  :focus:not(:focus-visible) { outline: none; }
  :focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* Menu movil
   Sin JavaScript: un checkbox oculto y su label. Al marcarlo se despliega
   el panel de enlaces. El breakpoint literal replica --breakpoint-md,
   porque las media queries no admiten var(). */
.nav-toggle,
.nav-toggle-label { display: none; }

@media (max-width: 768px) {
    nav {
      padding: var(--space-3) var(--space-4);
      position: relative;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .nav-toggle-label {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: var(--touch-target-min);
      height: var(--touch-target-min);
      padding: 0 9px;
      margin-left: auto;
      cursor: pointer;
      border: 1px solid var(--outline-variant);
      border-radius: var(--radius-sm);
      background: var(--surface);
    }

    .nav-toggle-label span {
      display: block;
      height: 2px;
      background: var(--on-surface);
      border-radius: 2px;
    }

    .nav-toggle:focus-visible + .nav-toggle-label {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .nav-toggle:checked + .nav-toggle-label span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked + .nav-toggle-label span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked + .nav-toggle-label span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Panel desplegable: a ancho completo, encima del contenido */
    .nav-links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: var(--space-1);
      margin: var(--space-2) 0 0;
      padding: var(--space-2) 0 0;
      border-top: 1px solid var(--outline-variant);
    }

    .nav-toggle:checked ~ .nav-links { display: flex; }

    .nav-links a {
      display: block;
      padding: var(--space-3) var(--space-2);
      min-height: var(--touch-target-min);
      border-bottom: none;
      border-radius: var(--radius-sm);
    }

    /* El logo y el CTA tambien deben ser alcanzables con el dedo */
    .cta-button {
      min-height: var(--touch-target-min);
      padding: var(--space-2) var(--space-4);
    }

    .nav-links a:hover,
    .nav-links a:focus {
      background: var(--surface-container);
      border-bottom-color: transparent;
    }
  }

  /* Objetivos tactiles: minimo 44px en cualquier control interactivo */
a,
button,
summary,
input[type='checkbox'] + label {
  touch-action: manipulation;
}

.btn-primary,
.btn-secondary,
.cta-button,
button {
  min-height: max(48px, var(--touch-target-min));
}

/* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>